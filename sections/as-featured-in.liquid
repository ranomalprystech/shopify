<section class="as-featured-in">
  <div class="as-featured-in__inner">

    {% if section.settings.heading != blank %}
      <h2 class="as-featured-in__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="as-featured-in__carousel"
        data-carousel
        id="carousel-{{ section.id }}">

        <button
          type="button"
          class="as-featured-in__arrow as-featured-in__arrow--prev"
          data-carousel-prev
          aria-label="Previous">
          &#10094;
        </button>

        <div class="as-featured-in__track" data-carousel-track>
          {% for block in section.blocks %}
            {% if block.type == 'logo' %}
              <div class="as-featured-in__slide" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
                {% if block.settings.image %}
                  {{ block.settings.image
 | image_url: width: 400
 | image_tag: loading: 'lazy', widths: '200, 300, 400', alt: block.settings.image.alt | default: 'Featured logo'
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'as-featured-in__placeholder' }}
                {% endif %}
                {% if block.settings.link != blank %}</a>{% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <button
          type="button"
          class="as-featured-in__arrow as-featured-in__arrow--next"
          data-carousel-next
          aria-label="Next">
          &#10095;
        </button>

      </div>

      <div
        class="as-featured-in__dots"
        data-carousel-dots
        role="tablist"
        aria-label="Carousel pages"></div>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="as-featured-in__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.spotify_embed_url != blank %}
      <div class="as-featured-in__spotify">
        <iframe
          src="{{ section.settings.spotify_embed_url }}"
          width="100%"
          height="352"
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          title="Spotify playlist"></iframe>
      </div>
    {% endif %}

  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('carousel-{{ section.id }}');
    if (!root) return;
  
    var track = root.querySelector('[data-carousel-track]');
    var prevBtn = root.querySelector('[data-carousel-prev]');
    var nextBtn = root.querySelector('[data-carousel-next]');
    var dotsWrap = root.parentElement.querySelector('[data-carousel-dots]');
    var slides = Array.prototype.slice.call(track.children);
  
    if (!slides.length) return;
  
    function getVisibleCount() {
      var trackWidth = track.clientWidth;
      var slideWidth = slides[0].getBoundingClientRect().width;
      return Math.max(1, Math.round(trackWidth / slideWidth));
    }
  
    function getPageCount() {
      return Math.max(1, Math.ceil(slides.length / getVisibleCount()));
    }
  
    function getCurrentPage() {
      var pageWidth = track.clientWidth;
      return Math.round(track.scrollLeft / pageWidth);
    }
  
    function buildDots() {
      dotsWrap.innerHTML = '';
      var pageCount = getPageCount();
      for (var i = 0; i < pageCount; i++) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'as-featured-in__dot';
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        dot.addEventListener('click', function (index) {
          return function () {
            track.scrollTo({ left: index * track.clientWidth, behavior: 'smooth' });
          };
        }(i));
        dotsWrap.appendChild(dot);
      }
      updateActiveDot();
    }
  
    function updateActiveDot() {
      var dots = dotsWrap.querySelectorAll('.as-featured-in__dot');
      var current = getCurrentPage();
      dots.forEach(function (dot, i) {
        dot.classList.toggle('is-active', i === current);
      });
    }
  
    prevBtn.addEventListener('click', function () {
      track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' });
    });
  
    nextBtn.addEventListener('click', function () {
      track.scrollBy({ left: track.clientWidth, behavior: 'smooth' });
    });
  
    var scrollTimeout;
    track.addEventListener('scroll', function () {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(updateActiveDot, 100);
    });
  
    window.addEventListener('resize', buildDots);
  
    buildDots();
  })();
</script>

{% schema %}
  {
    "name": "As Featured In",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "As Featured In:"
      }, {
        "type": "textarea",
        "id": "subheading",
        "label": "Subheading",
        "default": "Find all of my podcast interviews compiled in the playlist below:"
      }, {
        "type": "url",
        "id": "spotify_embed_url",
        "label": "Spotify embed URL",
        "info": "In Spotify: Share > Embed playlist > copy the 'src' URL from the code (looks like https://open.spotify.com/embed/playlist/...)"
      }
    ],
    "blocks": [
      {
        "type": "logo",
        "name": "Logo",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Logo image"
          }, {
            "type": "url",
            "id": "link",
            "label": "Link (optional)"
          }
        ]
      }
    ],
    "max_blocks": 12,
    "presets": [
      {
        "name": "As Featured In",
        "blocks": [
          {
            "type": "logo"
          },
          {
            "type": "logo"
          },
          {
            "type": "logo"
          },
          {
            "type": "logo"
          }, {
            "type": "logo"
          }
        ]
      }
    ]
  }
{% endschema %}
<section class="loved-products">
  <div class="loved-products__inner">

    {% if section.settings.heading != blank %}
      <h2 class="loved-products__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="loved-products__grid">
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          {% liquid
            assign card_link = block.settings.link
            assign has_link = false
            if card_link != blank
              assign has_link = true
            endif
          %}

          <div class="loved-products__card" {{ block.shopify_attributes }}>

            {% if has_link %}<a href="{{ card_link }}" class="loved-products__media">{% endif %}
            {% if block.settings.image %}
              {{ block.settings.image
 | image_url: width: 600
 | image_tag:
 loading: 'lazy',
 widths: '300, 400, 600',
 alt: block.settings.image.alt | default: block.settings.title
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'loved-products__placeholder' }}
            {% endif %}
            {% if has_link %}</a>{% endif %}

            <div class="loved-products__info">
              {% if has_link %}
                <a href="{{ card_link }}" class="loved-products__title">
                  {{ block.settings.title }}
                </a>
              {% else %}
                <p class="loved-products__title">{{ block.settings.title }}</p>
              {% endif %}

              {% if block.settings.price != blank %}
                <p class="loved-products__price">{{ block.settings.price }}</p>
              {% endif %}
            </div>

          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="loved-products__button-wrap">
        <a href="{{ section.settings.button_link | default: '#' }}" class="loved-products__button">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
  {
    "name": "Loved Products",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "What Everyone's Loving"
      }, {
        "type": "text",
        "id": "button_text",
        "label": "Button text",
        "default": "Browse All Products"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }
    ],
    "blocks": [
      {
        "type": "card",
        "name": "Card",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }, {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Product title"
          }, {
            "type": "text",
            "id": "price",
            "label": "Price",
            "info": "Enter as text, e.g. $24.99 or from $25.50",
            "default": "$0.00"
          }, {
            "type": "url",
            "id": "link",
            "label": "Link",
            "info": "Leave blank for a non-clickable card"
          }
        ]
      }
    ],
    "max_blocks": 6,
    "presets": [
      {
        "name": "Loved Products",
        "blocks": [
          {
            "type": "card"
          },
          {
            "type": "card"
          },
          {
            "type": "card"
          },
          {
            "type": "card"
          }, {
            "type": "card"
          }, {
            "type": "card"
          }
        ]
      }
    ]
  }
{% endschema %}
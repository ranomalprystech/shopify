<section class="rachel-landing">
  <!-- Announcement Bar -->
  <div class="rachel-announcement">
    <a href="{{ section.settings.announcement_link }}">
      {{ section.settings.announcement_text }}
    </a>
  </div>

  <!-- Brand -->
  <div class="rachel-brand">
    <a href="{{ routes.root_url }}">
      {{ section.settings.brand_line_1 }}
      <br>
      {{ section.settings.brand_line_2 }}
    </a>
  </div>

  <!-- Navigation -->
  <nav class="rachel-nav">
    {% for block in section.blocks %}
    {% if block.type == 'nav_item' %}
    <a href="{{ block.settings.link }}" class="rachel-nav__item" {{ block.shopify_attributes }}>
      {{ block.settings.label }}

      {% if block.settings.has_dropdown %}
      <span class="rachel-nav__arrow" aria-hidden="true"></span>
      {% endif %}

      {% comment %} {% if block.settings.has_dropdown %}
      <span class="rachel-nav__arrow">⌄</span>
      {% endif %} {% endcomment %}
    </a>
    {% endif %}
    {% endfor %}
  </nav>

  <!-- Hero -->
  <div class="rachel-hero">

    <div class="rachel-hero__heading">
      {% if section.settings.heading != blank %}
      <h1>{{ section.settings.heading }}</h1>
      {% endif %}
    </div>

    <div class="rachel-hero__content">

      <!-- Left -->
      <div class="rachel-hero__left">

        {% if section.settings.left_text_1 != blank %}
        <p>{{ section.settings.left_text_1 }}</p>
        {% endif %}

        {% if section.settings.left_text_2 != blank %}
        <p>{{ section.settings.left_text_2 }}</p>
        {% endif %}

        {% if section.settings.highlight_text != blank %}
        <p class="rachel-hero__highlight">
          {{ section.settings.highlight_text }}
        </p>
        {% endif %}

      </div>

      <!-- Center -->
      <div class="rachel-hero__center">

        <div class="rachel-image-frame">

          {% if section.settings.main_image != blank %}
          {{
          section.settings.main_image
          | image_url: width: 1000
          | image_tag:
          loading: 'lazy',
          widths: '400, 600, 800, 1000',
          sizes: '(max-width: 749px) 90vw, 400px'
          }}
          {% endif %}

          {% if section.settings.image_caption != blank %}
          <div class="rachel-image-caption">
            {{ section.settings.image_caption }}
          </div>
          {% endif %}

        </div>

        {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="rachel-button">
          {{ section.settings.button_text }}
        </a>
        {% endif %}

      </div>

      <!-- Right -->
  <!-- Right -->
<div class="rachel-hero__right">

  <img
    src="{{ 'Group.png' | asset_url }}"
    alt=""
    class="rachel-quote-mark rachel-quote-mark--open"
    aria-hidden="true"
  >

  {% if section.settings.quote != blank %}
    <p class="rachel-hero__quote">
      {{ section.settings.quote }}
      fsadfasdfasd
    </p>
  {% endif %}

  <img
    src="{{ 'close_quote.png' | asset_url }}"
    alt=""
    class="rachel-quote-mark rachel-quote-mark--close"
    aria-hidden="true"
  >

</div>



    </div>

  </div>

</section>


{% schema %}
{
"name": "Rachel Landing",
"settings": [
{
"type": "text",
"id": "announcement_text",
"label": "Announcement text",
"default": "Pre-Order “Look Up,” my new book!"
},
{
"type": "url",
"id": "announcement_link",
"label": "Announcement link"
},
{
"type": "text",
"id": "brand_line_1",
"label": "Brand line 1",
"default": "RACHEL"
},
{
"type": "text",
"id": "brand_line_2",
"label": "Brand line 2",
"default": "HAVEKOST"
},
{
"type": "text",
"id": "heading",

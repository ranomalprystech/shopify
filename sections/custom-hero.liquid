<section class="rachel-landing">
  <div class="rachel-hero">
    <div class="rachel-hero heading">
      {% if section.settings.heading != blank %}
        <h1>{{ section.settings.heading }}</h1>
      {% endif %}
    </div>

    <div class="content">

      <!-- Left -->
      <div class="left">

        {% if section.settings.left_text_1 != blank %}
          <p>{{ section.settings.left_text_1 }}</p>
        {% endif %}

        {% if section.settings.left_text_2 != blank %}
          <p>{{ section.settings.left_text_2 }}</p>
        {% endif %}

        {% if section.settings.highlight_text != blank %}
          <p class="highlight">
            {{ section.settings.highlight_text }}
          </p>
        {% endif %}

      </div>

      <!-- Center -->
      <div class="center">

        <div class="rachel-image-frame">

          {% if section.settings.main_image != blank %}
            {{ section.settings.main_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000' }}
          {% endif %}

          {% if section.settings.image_caption != blank %}
            <div class="rachel-image-caption">
              {{ section.settings.image_caption }}
            </div>
          {% endif %}

        </div>

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="rachel-button">
            {{ section.settings.button_text }}
          </a>
        {% endif %}

      </div>

      <!-- Right -->
      <div class="right">

        <span class="rachel-quote-mark rachel-quote-mark--open">
          “
        </span>

        {% if section.settings.quote != blank %}
          <p>{{ section.settings.quote }}</p>
        {% endif %}

        <span class="rachel-quote-mark rachel-quote-mark--close">
          ”
        </span>

      </div>

    </div>
  </div>

</section>


{% schema %}
  {
    "name": "Rachel Landing",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Main heading",
        "default": "WORDS FOR THE HEALING JOURNEY."
      },
      {
        "type": "image_picker",
        "id": "main_image",
        "label": "Main image"
      },
      {
        "type": "textarea",
        "id": "left_text_1",
        "label": "Left paragraph 1",
        "default": "Taking wisdom and lessons from 18 years of therapy and paying it forward with radical transparency, vulnerability, and education."
      },
      {
        "type": "textarea",
        "id": "left_text_2",
        "label": "Left paragraph 2",
        "default": "It is my hope that you finally feel safe to show up as the fullest you, and that in doing so you learn to radically love and accept others in their full self-states, too."
      }, {
        "type": "textarea",
        "id": "highlight_text",
        "label": "Highlighted text",
        "default": "Whatever you do, I hope you live with purpose, lead with love, & connect with courage."
      }, {
        "type": "textarea",
        "id": "quote",
        "label": "Quote",
        "default": "I’m not interested in befores and afters. Show me the messy middle."
      }, {
        "type": "text",
        "id": "image_caption",
        "label": "Image caption",
        "default": "AUTHOR. STORYTELLER. TEACHER."
      }, {
        "type": "text",
        "id": "button_text",
        "label": "Button text",
        "default": "More About Rachel"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }
    ],
    "presets": [
      {
        "name": "Rachel Landing"
      }
    ]
  }
{% endschema %}
{% comment %} <section class="hero" 40px>
                <div class="inner">
                  <h1 class="heading">
              
                  </h1>
                </div>
</section> {% endcomment %}
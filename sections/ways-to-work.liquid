<section class="work_section_bg">

  <section class="work_landing">

    <div class="work_landing heading">
      {% if section.settings.heading != blank %}
        <h1>{{ section.settings.heading }}</h1>
      {% endif %}
    </div>

    <div class="work_landing content">

      <div class="left">

        {% if section.settings.intro != blank %}
          <p class="intro">
            {{ section.settings.intro }}
          </p>
        {% endif %}

        {% if section.settings.previous_text != blank %}
          <p>
            {{ section.settings.previous_text }}
          </p>
        {% endif %}

        {% if section.settings.previous_points != blank %}
          <p>
            {{ section.settings.previous_points | newline_to_br }}
          </p>
        {% endif %}

        {% if section.settings.topics_text != blank %}
          <p>
            {{ section.settings.topics_text }}
          </p>
        {% endif %}

        {% if section.settings.topic_points != blank %}
          <p>
            {{ section.settings.topic_points | newline_to_br }}
          </p>
        {% endif %}

        {% if section.settings.closing != blank %}
          <p class="closing">
            {{ section.settings.closing }}
          </p>
        {% endif %}

      </div>

      <div class="right">

        {% if section.settings.image != blank %}
          {{ section.settings.image
 | image_url: width: 1200
 | image_tag:
 loading: 'lazy',
 widths: '400, 600, 800, 1000, 1200'
          }}
        {% endif %}

      </div>

    </div>

  </section>

</section>

{% schema %}
  {
    "name": "Ways to Work With Rachel",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "WAYS TO WORK WITH RACHEL"
      },
      {
        "type": "textarea",
        "id": "intro",
        "label": "Intro",
        "default": "Rachel is available for in-person speaking engagements, workshops, summits, and more."
      },
      {
        "type": "textarea",
        "id": "previous_text",
        "label": "Previous events heading",
        "default": "She has previously shared her voice and presence at:"
      },
      {
        "type": "textarea",
        "id": "previous_points",
        "label": "Previous events",
        "default": "– Harvard’s Mental Health Creator’s Summit.\n– Keynote speaker at Cadre’s Wellness Summit in Minneapolis.\n– Guest speaker at the Moving America’s Soul on Suicide film premiere (in conjunction with the 988 Crisis Line).\n– Facilitator & co-host of Saturday Sabbatical Wellness in Seattle."
      }, {
        "type": "textarea",
        "id": "topics_text",
        "label": "Topics heading",
        "default": "Rachel speaks on topics like:"
      }, {
        "type": "textarea",
        "id": "topic_points",
        "label": "Topics",
        "default": "– What it means to be “well” and redefining wellness\n– Belonging and being your true self\n– Radical acceptance and embracing reality\n– Suicide awareness and prevention\n– Eating disorder recovery\n– Grief and reclaiming self"
      }, {
        "type": "textarea",
        "id": "closing",
        "label": "Closing text",
        "default": "While these are generally themes Rachel focuses on, she is always happy to work with folks and create new and meaningful experiences or workshops based on their needs, so please don’t hesitate to reach out and begin a conversation!"
      }, {
        "type": "image_picker",
        "id": "image",
        "label": "Rachel image"
      }
    ],
    "presets": [
      {
        "name": "Ways to Work With Rachel"
      }
    ]
  }
{% endschema %}